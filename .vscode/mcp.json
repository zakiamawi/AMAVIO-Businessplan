{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "composio": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "composio-mcp@latest"],
      "env": {
        "COMPOSIO_API_KEY": "${COMPOSIO_API_KEY}"
      }
    },
    "brightdata": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote@latest", "https://api.mcp.github.com/v0.1/servers/io.github.brightdata%2Fbrightdata-mcp/versions/latest"],
      "env": {
        "BRIGHTDATA_API_KEY": "${BRIGHTDATA_API_KEY}"
      }
    },
    "plori": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote@latest", "https://api.plori.ai/mcp"],
      "env": {
        "PLORI_API_KEY": "${PLORI_API_KEY}"
      }
    },
    "azure": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote@latest", "https://api.mcp.github.com/v0.1/servers/com.microsoft%2Fazure/versions/latest"]
    },
    "guru": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote@latest", "https://api.getguru.com/mcp"],
      "env": {
        "GURU_API_TOKEN": "${GURU_API_TOKEN}"
      }
    }
  }
}
