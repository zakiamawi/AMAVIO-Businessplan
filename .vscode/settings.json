{
  "chat.mcp.autoStart": true,
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true,
    "windsurf": true,
    "cursor-global": true,
    "cursor-workspace": true
  },
  "DockerRun.DisableDockerrc": true,
  "claudeCodeChat.permissions.yoloMode": false,
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(ssh *)",
      "Bash(* > /dev/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .github/agentshield-pretool-guard.mjs"
          }
        ]
      }
    ]
  },
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "./04_Final_Abgabe_v2_1",
    "-p",
    "*test.py"
  ],
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true
}
