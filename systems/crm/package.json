{
  "name": "amavio-one-crm-cockpit",
  "private": true,
  "version": "0.3.13-r3-17-unified-global-search",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && node scripts/local-crm-server.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "qa": "node scripts/qa-gate.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:component": "node --test tests/component/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:staging": "node --test tests/contract/real-data-staging.test.mjs",
    "test:logic": "npm run test:unit && npm run test:contract && npm run test:component && npm run test:integration",
    "test:e2e": "node scripts/e2e-core.mjs && node scripts/e2e-imported-crm-records.mjs",
    "test:persistence": "node --test tests/persistence/*.test.mjs",
    "qa:browser": "node scripts/browser-qa.mjs",
    "qa:full": "npm run build && npm run qa && npm run test:logic && npm run test:persistence"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.0",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.5"
  }
}
